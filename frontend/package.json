{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:size": "node scripts/check-bundle-size.js",
    "check:contrast": "node scripts/a11y-audit/palette.mjs",
    "lint": "oxlint --deny-warnings --format=default",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "node scripts/audit-deps.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "check": "npm run lint && npm run check:contrast && npm run test:coverage && npm run build && npm run check:size && npm run audit:deps",
    "a11y:audit": "node scripts/a11y-audit/run.mjs",
    "mobile:audit": "node scripts/mobile-audit/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
